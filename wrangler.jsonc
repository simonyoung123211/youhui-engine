{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "youhui-engine",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "engine.yangyaojun-demo.cn/*",
      "zone_name": "yangyaojun-demo.cn"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
